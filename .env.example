# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copia este archivo a .env y asigna tu API Key correspondiente
# ==============================================================================

# Proveedor activo por defecto (gemini, openai, ollama, offline)
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Alternativa)
OPENAI_API_KEY=tu_clave_de_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# Ollama Local (Alternativa local sin costo)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Parámetros de optimización de tokens
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=1024
